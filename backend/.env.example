# ---- LLM provider ---------------------------------------------------------
# ollama (default, local, free) | openai (any OpenAI-compatible API) | offline (no model, built-in fallback only)
LLM_PROVIDER=ollama
# If the provider is unreachable: "offline" uses the built-in fallback (clearly labelled in the UI); "none" returns an error.
LLM_FALLBACK=offline

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Only used when LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.4

# ---- Context management -----------------------------------------------------
# Token budget for each model call (system prompt + history). Can be overridden per request from the UI Settings page.
CONTEXT_TOKEN_BUDGET=3000
# Individual messages larger than this are truncated (head + tail) in the model context only; the checkpoint keeps them whole.
MAX_MESSAGE_TOKENS=1200
# auto = tiktoken if its vocabulary can be loaded, else a labelled chars/4 approximation. Or force: tiktoken | approx
TOKEN_COUNTER=auto

# ---- Behaviour --------------------------------------------------------------
DEFAULT_USER_ID=demo-student
ROUTER_MODE=hybrid
MEMORY_EXTRACTION=rules
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=200000

# ---- Storage ----------------------------------------------------------------
# STUDYMATE_DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
